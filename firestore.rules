  match /certificate_status_history/{id} {
   allow read: if active()&&profile().role in ['master_admin','owner','admin','manager','accountant'];
   allow create: if active()&&profile().role in ['master_admin','admin','manager','accountant']&&request.resource.data.changed_by_uid==request.auth.uid&&request.resource.data.changed_at==request.time&&request.resource.data.previous_status is string&&request.resource.data.new_status in ['Installed','Not Installed','Uninstalled'];
   allow update, delete: if false;
  }
  match /certificate_payment_history/{id} {
   allow read: if active()&&profile().role in ['master_admin','owner','admin','manager','accountant'];
   allow create: if active()&&profile().role in ['master_admin','admin','manager','accountant']&&request.resource.data.changed_by_uid==request.auth.uid&&request.resource.data.changed_at==request.time&&request.resource.data.previous_status in ['Paid','Unpaid']&&request.resource.data.new_status in ['Paid','Unpaid'];
   allow update, delete: if false;
  }
  match /certificate_edit_history/{id} {
   allow read: if active()&&profile().role in ['master_admin','owner','admin','manager','accountant'];
   allow create: if active()&&profile().role in ['master_admin','owner','admin','manager','accountant']&&request.resource.data.changed_by_uid==request.auth.uid&&request.resource.data.changed_at==request.time&&request.resource.data.certificate_id is string&&request.resource.data.previous is map;
   allow update, delete: if false;
  }
  match /error_logs/{id} {
   allow read: if active()&&profile().role in ['master_admin','admin'];
   allow create: if active()
    &&request.resource.data.keys().hasOnly(['severity','message','stack','module','user_uid','request_url','context','created_at'])
    &&request.resource.data.user_uid==request.auth.uid
    &&request.resource.data.severity=='error'
    &&request.resource.data.message is string&&request.resource.data.message.size()<=1000
    &&request.resource.data.stack is string&&request.resource.data.stack.size()<=6000
    &&request.resource.data.module is string&&request.resource.data.module.size()<=120
    &&request.resource.data.request_url is string&&request.resource.data.request_url.size()<=500
    &&request.resource.data.context is map
    &&request.resource.data.created_at==request.time;
   allow update, delete: if false;
  }
  match /certificate_settings/{id} {
   allow read: if active()&&profile().role in ['master_admin','owner','admin','manager','accountant'];
   allow create, update: if active()&&profile().role in ['master_admin','admin']&&id=='global';
   allow delete: if false;
  }
  match /device_models/{id} {
   allow read: if staff();
   allow create: if active()&&profile().role in ['master_admin','admin']&&request.resource.data.name is string&&request.resource.data.name.size()>0&&request.resource.data.status in ['active','inactive','archived'];
   allow update: if active()&&profile().role in ['master_admin','admin']&&request.resource.data.name is string&&request.resource.data.name.size()>0&&request.resource.data.status in ['active','inactive','archived'];
   allow delete: if false;
  }
  match /renewals/{id} {
   allow read: if active()&&profile().role in ['master_admin','owner','admin','manager','accountant'];
   allow create: if active()&&profile().role in ['master_admin','admin','accountant']&&request.resource.data.identity is string&&request.resource.data.identity.size()>0&&request.resource.data.company_name is string&&request.resource.data.company_name.size()>0&&request.resource.data.vehicle_number is string&&request.resource.data.chassis_number is string&&request.resource.data.updated_by_uid==request.auth.uid&&request.resource.data.updated_at==request.time;
   allow update: if (active()&&profile().role in ['master_admin','admin','accountant']&&request.resource.data.identity==resource.data.identity&&request.resource.data.company_name is string&&request.resource.data.company_name.size()>0&&request.resource.data.vehicle_number is string&&request.resource.data.chassis_number is string&&request.resource.data.updated_by_uid==request.auth.uid&&request.resource.data.updated_at==request.time)
    ||(master()&&resource.data.get('is_deleted',false)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_deleted','lifecycle','restored_at','restored_by_uid','restored_by_name','updated_at','updated_by_uid','updated_by_name'])&&request.resource.data.is_deleted==false&&request.resource.data.lifecycle==resource.data.get('previous_lifecycle','Upcoming')&&request.resource.data.restored_at==request.time&&request.resource.data.restored_by_uid==request.auth.uid&&request.resource.data.updated_by_uid==request.auth.uid&&request.resource.data.updated_at==request.time);
   allow delete: if false;
  }
  match /audit_events/{id} {
   allow read: if master();
   allow create: if active()&&request.resource.data.actor_uid==request.auth.uid&&request.resource.data.actor_role==profile().role&&request.resource.data.action in ['CREATED','EDITED','ASSIGNED','REASSIGNED','COMPLETED','CANCELLED','DELETED','RESTORED','IMPORTED','EXPORTED','STATUS_CHANGED','PERMISSION_CHANGED']&&request.resource.data.module is string&&request.resource.data.record_id is string&&request.resource.data.changes is map&&request.resource.data.search_tokens is list&&request.resource.data.created_at==request.time;
   allow update, delete: if false;
  }
  match /operational_notifications/{id} {
   allow read: if staff();
   allow create: if active()&&request.resource.data.actor_uid==request.auth.uid&&request.resource.data.type in ['vehicle_completed','job_completed']&&request.resource.data.get('recipient_roles',[]) is list&&request.resource.data.read_by==[]&&request.resource.data.created_at==request.time;
   allow update: if staff()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_by'])&&request.resource.data.read_by is list&&request.resource.data.read_by.hasAll([request.auth.uid]);
   allow delete: if false;
  }
  }
}
