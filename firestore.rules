rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function owner(uid){return signedIn()&&request.auth.uid==uid;}
  function profile(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function active(){return signedIn()&&profile().get('status','active')!='deactivated';}
  function role(r){return active()&&profile().role==r;}
  function staff(){return active()&&profile().role in ['master_admin','owner','admin','manager','accountant','hr','it'];}
  function master(){return role('master_admin');}
  function stockAdmin(){return active()&&profile().role in ['master_admin','admin','accountant'];}
  function assigner(){return active()&&profile().role in ['master_admin','admin'];}
  function agreementStaff(){return active()&&profile().role in ['master_admin','owner','admin','accountant','hr'];}
  function model(v){return v is string&&v.size()>0&&v.size()<=80;}
  function job(v){return v in ['new_installation','device_change','sim_change','sim_device_change','device_removal','payment_collection','inspection','mixed'];}
  function inspectionAction(v){return v in ['check_only','device_change','sim_change','sim_device_change'];}
  function simProvider(v){return v in ['Etisalat','du','International'];}
  function validPhoto(d){return d.get('photoDataUrl','') is string&&d.get('photoDataUrl','').size()<=200000;}
  function integer(v){return v is int&&v>=0&&v<=10000;}
  function coordinates(d){return d.latitude is number&&d.latitude>=-90&&d.latitude<=90&&d.longitude is number&&d.longitude>=-180&&d.longitude<=180;}
  function optionalCoordinates(d){return !d.keys().hasAny(['latitude','longitude'])||(d.keys().hasAll(['latitude','longitude'])&&coordinates(d));}
  function completionCoordinates(d){return d.completion_latitude is number&&d.completion_latitude>=-90&&d.completion_latitude<=90&&d.completion_longitude is number&&d.completion_longitude>=-180&&d.completion_longitude<=180&&d.completion_accuracy_m is number&&d.completion_accuracy_m>=0;}
  function movementAccessories(d){let r12=d.get('relay_12v_count',0);let r24=d.get('relay_24v_count',0);let wire=d.get('wire_count',0);return integer(r12)&&integer(r24)&&integer(wire)&&(d.type=='received'||((r12+r24)<=d.quantity&&wire<=d.quantity&&(r12+r24+wire==0||d.device_model.matches('FMC.*'))));}
  function completionAccessories(d){let r12=d.get('relay_12v_count',0);let r24=d.get('relay_24v_count',0);let wire=d.get('wire_count',0);return integer(r12)&&integer(r24)&&integer(wire)&&(r12+r24)<=d.device_imeis.size()&&wire<=d.device_imeis.size()&&(r12+r24+wire==0||d.device_model.matches('FMC.*'));}
  function assignedShift(id){return get(/databases/$(database)/documents/shifts/$(id)).data;}
  function assignedJobType(id){return assignedShift(id).get('job_type','new_installation');}
  function assignedUnitCount(id){return assignedShift(id).get('unit_count',1);}
  function completion(id){return getAfter(/databases/$(database)/documents/installations/$(id)).data;}
  function completionShift(id){return assignedShift(completion(id).shift_id);}
  function validJobCore(d){return d.job_reference is string&&d.job_reference.matches('ST[0-9]{5,}')&&d.technician_id is string&&d.technician_name is string&&d.site_name is string&&d.company_name is string&&d.contact_person is string&&d.customer_phone is string&&d.vehicle_number is string&&d.vehicle_numbers is list&&d.unit_jobs is list&&d.maps_url is string&&job(d.job_type)&&d.unit_count is int&&d.unit_count>=1&&d.unit_count<=50&&d.unit_jobs.size()==d.unit_count&&optionalCoordinates(d)&&d.scheduled_at is timestamp&&d.window_start is timestamp&&d.window_end is timestamp&&d.window_start<=d.scheduled_at&&d.scheduled_at<d.window_end&&d.get('duration_minutes',60) is int&&d.get('duration_minutes',60)>=15&&d.get('duration_minutes',60)<=720&&d.get('expected_end_at',d.scheduled_at+duration.value(d.get('duration_minutes',60),'m'))>d.scheduled_at&&d.get('job_notes','') is string&&d.get('job_notes','').size()<=1500&&d.get('payment_collection_required',false) is bool&&d.get('payment_amount',0) is number&&d.get('payment_amount',0)>=0&&d.get('payment_amount',0)<=1000000;}
  function validScheduledJob(d){return d.company_name.size()>0&&d.contact_person.size()>0&&d.customer_phone.size()>0&&d.vehicle_number.size()>0&&d.maps_url.size()>0&&exists(/databases/$(database)/documents/users/$(d.technician_id))&&get(/databases/$(database)/documents/users/$(d.technician_id)).data.role=='technician';}

  match /users/{uid} {
   allow read: if owner(uid)||staff();
   allow create: if assigner()&&request.resource.data.keys().hasOnly(['uid','email','displayName','photoDataUrl','role','status','inventory_count','inventory_breakdown','created_at'])
    &&request.resource.data.uid==uid&&request.resource.data.email is string&&request.resource.data.displayName is string&&request.resource.data.displayName.size()>0&&request.resource.data.displayName.size()<=160
    &&request.resource.data.role in ['admin','manager','accountant','hr','it','technician']&&request.resource.data.status=='active'&&request.resource.data.inventory_count==0&&validPhoto(request.resource.data)
    &&request.resource.data.inventory_breakdown=={'fmc920':0,'fmc130':0,'sim_cards':0}&&request.resource.data.created_at==request.time;
   allow update: if (master()&&uid!=request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status','photoDataUrl','is_deleted','deleted_at','deleted_by_uid','deleted_by_name','deletion_reason'])
     &&request.resource.data.role in ['master_admin','admin','manager','accountant','hr','it','technician']&&request.resource.data.get('status','active') in ['active','deactivated']&&validPhoto(request.resource.data))
    ||(owner(uid)&&active()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoDataUrl'])&&request.resource.data.displayName is string&&request.resource.data.displayName.size()<=160&&validPhoto(request.resource.data));
   allow delete: if uid!=request.auth.uid&&(master()||(role('admin')&&!(resource.data.role in ['master_admin','owner'])));
  }
  match /settings/{id} {
   allow read: if active();
   allow create, update: if (stockAdmin()||role('hr'))&&id=='stock_alerts'&&request.resource.data.keys().hasOnly(['threshold','device_minimums','sim_minimums','clock_in_time','clock_out_time','late_grace_minutes','max_break_minutes','updated_at'])&&integer(request.resource.data.threshold)&&request.resource.data.get('device_minimums',{}) is map&&request.resource.data.get('sim_minimums',{}) is map&&request.resource.data.clock_in_time is string&&request.resource.data.clock_in_time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')&&request.resource.data.clock_out_time is string&&request.resource.data.clock_out_time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')&&request.resource.data.late_grace_minutes is int&&request.resource.data.late_grace_minutes>=0&&request.resource.data.late_grace_minutes<=180&&request.resource.data.max_break_minutes is int&&request.resource.data.max_break_minutes>=1&&request.resource.data.max_break_minutes<=240&&request.resource.data.updated_at==request.time;
   allow delete: if master();
  }
  match /inventory_accounts/{uid} {
   function legacyBalance(){let p=get(/databases/$(database)/documents/users/$(uid)).data;let b=p.get('inventory_breakdown',{});let total=p.get('inventory_count',0);return{'FMC920':b.get('fmc920',math.floor(total / 2)),'FMC130':b.get('fmc130',math.ceil(total / 2)),'FMC125':0,'FMM130':0,'FMM125':0,'Jimi VL03':0,'GT06':0,'GT06N':0,'LV02':0,'Ruptela':0,'Relay 12V':0,'Relay 24V':0,'Wire':0,'SIM Etisalat':0,'SIM du':0,'SIM International':0,'SIM':b.get('sim_cards',0)};}
   function oldLegacyBalance(){let p=get(/databases/$(database)/documents/users/$(uid)).data;let b=p.get('inventory_breakdown',{});let total=p.get('inventory_count',0);return{'FMC920':b.get('fmc920',math.floor(total / 2)),'FMC130':b.get('fmc130',math.ceil(total / 2)),'FMC125':0,'FMM130':0,'FMM125':0,'Jimi VL03':0,'GT06':0,'GT06N':0,'LV02':0,'Ruptela':0,'SIM':b.get('sim_cards',0)};}
   allow read: if active()&&(owner(uid)||resource.data.technician_id==request.auth.uid||staff());
   allow create: if (owner(uid)||stockAdmin())&&active()&&request.resource.data.keys().hasOnly(['technician_id','opening','timestamp'])&&request.resource.data.technician_id==uid&&request.resource.data.timestamp==request.time&&(request.resource.data.opening==legacyBalance()||request.resource.data.opening==oldLegacyBalance());
    allow update: if false;
   allow delete: if master();
  }
  match /company_inventory/{id} {
   allow read: if staff();
   allow create, update: if id=='global'&&stockAdmin()&&request.resource.data.keys().hasOnly(['balance','updated_at','updated_by','updated_by_uid'])&&request.resource.data.balance is map&&request.resource.data.updated_at==request.time&&request.resource.data.updated_by is string&&request.resource.data.updated_by_uid==request.auth.uid;
   allow delete: if master();
  }
  match /company_inventory_history/{id} {
   allow read: if staff();
   allow create: if stockAdmin()&&request.resource.data.keys().hasOnly(['previous','next','notes','changed_at','changed_by','changed_by_uid'])&&request.resource.data.previous is map&&request.resource.data.next is map&&request.resource.data.notes is string&&request.resource.data.notes.size()>0&&request.resource.data.notes.size()<=1000&&request.resource.data.changed_at==request.time&&request.resource.data.changed_by_uid==request.auth.uid;
   allow update, delete: if false;
  }
  match /technician_live_stock/{uid} {
   allow read: if active()&&(owner(uid)||staff());
   allow create: if active()&&(owner(uid)||stockAdmin())&&request.resource.data.technician_id==uid&&request.resource.data.balance is map&&request.resource.data.updated_at==request.time;
   allow update: if active()&&(owner(uid)||stockAdmin())&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['technician_id','balance','updated_at'])&&request.resource.data.technician_id==uid&&request.resource.data.balance is map&&request.resource.data.updated_at==request.time;
   allow delete: if master();
  }
  match /assignment_index/{id} {
   allow read: if active();
   allow create, update: if active()&&request.resource.data.assigned_by_uid==request.auth.uid&&request.resource.data.kind in ['imei','sim']&&request.resource.data.value is string&&request.resource.data.value.size()>0&&request.resource.data.vehicle is string&&request.resource.data.installation_id is string&&request.resource.data.status in ['active','uninstalled']&&request.resource.data.assigned_at==request.time&&getAfter(/databases/$(database)/documents/installations/$(request.resource.data.installation_id)).data.technician_id==request.auth.uid;
   allow delete: if false;
  }
  match /job_online_status_history/{id} {
   allow read: if staff();
   allow create: if active()&&profile().role in ['master_admin','admin','manager','hr']&&request.resource.data.changed_by_uid==request.auth.uid&&request.resource.data.changed_at==request.time&&request.resource.data.previous_status in ['not_showing','not_checked']&&request.resource.data.new_status in ['showing_online','not_showing'];
   allow update, delete: if false;
  }
  match /inventory_logs/{id} {
   function validMovement(d){return d.keys().hasOnly(['technician_id','technician_name','type','device_model','quantity','sim_count','relay_12v_count','relay_24v_count','wire_count','device_imeis','sim_provider','timestamp','captured_at','notes'])&&d.technician_name is string&&d.notes is string&&d.notes.size()<=1000&&integer(d.quantity)&&integer(d.sim_count)&&d.quantity+d.sim_count+d.get('relay_12v_count',0)+d.get('relay_24v_count',0)+d.get('wire_count',0)>0&&((d.quantity==0&&d.device_model=='')||(d.quantity>0&&model(d.device_model)))&&movementAccessories(d)&&(!d.keys().hasAny(['device_imeis'])||(d.device_imeis is list&&d.device_imeis.size()<=d.quantity))&&(!d.keys().hasAny(['sim_provider'])||simProvider(d.sim_provider))&&d.timestamp==request.time&&d.captured_at is timestamp;}
   function validAdjustment(d){return d.keys().hasOnly(['technician_id','technician_name','type','device_model','quantity','sim_count','quantity_delta','sim_delta','sim_provider','timestamp','captured_at','notes'])&&d.type=='adjustment'&&d.technician_name is string&&d.notes is string&&d.notes.size()>0&&d.notes.size()<=1000&&d.quantity==0&&d.sim_count==0&&d.quantity_delta is int&&d.quantity_delta>=-10000&&d.quantity_delta<=10000&&d.sim_delta is int&&d.sim_delta>=-10000&&d.sim_delta<=10000&&((model(d.device_model)&&d.quantity_delta!=0&&d.sim_delta==0)||(d.device_model==''&&d.quantity_delta==0&&d.sim_delta!=0))&&(!d.keys().hasAny(['sim_provider'])||simProvider(d.sim_provider))&&d.timestamp==request.time&&d.captured_at==request.time;}
   allow get: if active()&&!exists(/databases/$(database)/documents/inventory_logs/$(id));
   allow read: if active()&&(resource.data.technician_id==request.auth.uid||staff());
   allow create: if active()
    &&(validMovement(request.resource.data)||validAdjustment(request.resource.data))
    &&getAfter(/databases/$(database)/documents/inventory_accounts/$(request.resource.data.technician_id)).data.technician_id==request.resource.data.technician_id
    &&((stockAdmin()&&request.resource.data.type in ['received','adjustment'])||(
      request.resource.data.technician_id==request.auth.uid
      &&completion(id).technician_id==request.auth.uid
      &&completionShift(id).technician_id==request.auth.uid
      &&request.resource.data.quantity==completion(id).device_imeis.size()
      &&request.resource.data.sim_count==completion(id).sim_numbers.size()
      &&request.resource.data.get('relay_12v_count',0)==completion(id).get('relay_12v_count',0)
      &&request.resource.data.get('relay_24v_count',0)==completion(id).get('relay_24v_count',0)
      &&request.resource.data.get('wire_count',0)==completion(id).get('wire_count',0)
      &&((request.resource.data.quantity>0&&request.resource.data.type=='installed')||(request.resource.data.quantity==0&&request.resource.data.sim_count>0&&request.resource.data.type=='sim-used'))
    ));
    allow update: if false;
   allow delete: if master();
  }
  match /installations/{id} {
   allow get: if active()&&!exists(/databases/$(database)/documents/installations/$(id));
   allow read: if active()&&(resource.data.get('technician_id','')==request.auth.uid||resource.data.get('tech_id','')==request.auth.uid||staff());
   allow create: if active()
    &&request.resource.data.keys().hasOnly(['technician_id','technician_name','shift_id','job_type','inspection_action','unit_count','unit_index','progress_completed','progress_total','unit_records','device_model','device_imeis','sim_numbers','sim_count','relay_12v_count','relay_24v_count','wire_count','sim_provider','customer_ref','vehicle_ref','notes','timestamp','completed_at','completion_latitude','completion_longitude','completion_accuracy_m','payment_received_amount','payment_method','completed_by_uid','completed_by_name','captured_at'])
    &&request.resource.data.technician_id==request.auth.uid&&request.resource.data.completed_by_uid==request.auth.uid
    &&assignedShift(request.resource.data.shift_id).technician_id==request.auth.uid
    &&request.resource.data.unit_index is int&&request.resource.data.unit_index>=0&&request.resource.data.unit_index<assignedUnitCount(request.resource.data.shift_id)
    &&request.resource.data.progress_total==assignedUnitCount(request.resource.data.shift_id)&&request.resource.data.progress_completed is int&&request.resource.data.progress_completed>=1&&request.resource.data.progress_completed<=request.resource.data.progress_total
    &&request.resource.data.unit_count==1&&request.resource.data.unit_records is list&&request.resource.data.unit_records.size()==1
    &&request.resource.data.job_type==assignedShift(request.resource.data.shift_id).unit_jobs[request.resource.data.unit_index].job_type
    &&request.resource.data.vehicle_ref==assignedShift(request.resource.data.shift_id).unit_jobs[request.resource.data.unit_index].vehicle_number
    &&request.resource.data.device_imeis is list&&request.resource.data.device_imeis.size()<=1&&request.resource.data.sim_numbers is list&&request.resource.data.sim_numbers.size()<=1&&request.resource.data.sim_count==request.resource.data.sim_numbers.size()&&completionAccessories(request.resource.data)
    &&request.resource.data.timestamp==request.time&&request.resource.data.completed_at==request.time&&request.resource.data.captured_at is timestamp&&completionCoordinates(request.resource.data)
    &&request.resource.data.customer_ref is string&&request.resource.data.customer_ref.size()>0&&request.resource.data.customer_ref.size()<=160&&request.resource.data.notes is string&&request.resource.data.notes.size()<=1000
    &&(!request.resource.data.keys().hasAny(['sim_provider'])||simProvider(request.resource.data.sim_provider))
    &&((request.resource.data.job_type in ['new_installation','sim_device_change']&&model(request.resource.data.device_model)&&request.resource.data.device_imeis.size()==1&&request.resource.data.sim_numbers.size()==1&&getAfter(/databases/$(database)/documents/inventory_logs/$(id)).data.type=='installed')
     ||(request.resource.data.job_type=='device_change'&&model(request.resource.data.device_model)&&request.resource.data.device_imeis.size()==1&&request.resource.data.sim_numbers.size()==0&&getAfter(/databases/$(database)/documents/inventory_logs/$(id)).data.type=='installed')
     ||(request.resource.data.job_type=='sim_change'&&request.resource.data.device_model==''&&request.resource.data.device_imeis.size()==0&&request.resource.data.sim_numbers.size()==1&&getAfter(/databases/$(database)/documents/inventory_logs/$(id)).data.type=='sim-used')
     ||(request.resource.data.job_type=='device_removal'&&request.resource.data.device_model==''&&request.resource.data.device_imeis.size()==1&&request.resource.data.sim_numbers.size()==0&&!existsAfter(/databases/$(database)/documents/inventory_logs/$(id)))
     ||(request.resource.data.job_type=='payment_collection'&&request.resource.data.device_model==''&&request.resource.data.device_imeis.size()==0&&request.resource.data.sim_numbers.size()==0&&request.resource.data.payment_received_amount is number&&request.resource.data.payment_method in ['cash','cheque']&&!existsAfter(/databases/$(database)/documents/inventory_logs/$(id)))
     ||(request.resource.data.job_type=='inspection'&&request.resource.data.keys().hasAny(['inspection_action'])&&((request.resource.data.inspection_action=='check_only'&&request.resource.data.device_imeis.size()==0&&request.resource.data.sim_numbers.size()==0&&!existsAfter(/databases/$(database)/documents/inventory_logs/$(id)))||(request.resource.data.inspection_action=='device_change'&&request.resource.data.device_imeis.size()==1&&request.resource.data.sim_numbers.size()==0&&getAfter(/databases/$(database)/documents/inventory_logs/$(id)).data.type=='installed')||(request.resource.data.inspection_action=='sim_change'&&request.resource.data.device_imeis.size()==0&&request.resource.data.sim_numbers.size()==1&&getAfter(/databases/$(database)/documents/inventory_logs/$(id)).data.type=='sim-used')||(request.resource.data.inspection_action=='sim_device_change'&&request.resource.data.device_imeis.size()==1&&request.resource.data.sim_numbers.size()==1&&getAfter(/databases/$(database)/documents/inventory_logs/$(id)).data.type=='installed'))));
   allow create: if assigner()&&!exists(/databases/$(database)/documents/installations/$(id))
    &&request.resource.data.keys().hasOnly(['technician_id','technician_name','shift_id','job_type','unit_count','device_model','device_imeis','sim_numbers','sim_count','customer_ref','vehicle_ref','notes','completion_source','completed_by_uid','completed_by_name','completed_by_role','completion_reason','timestamp','completed_at','captured_at'])
    &&request.resource.data.technician_id==assignedShift(id).technician_id&&request.resource.data.technician_name==assignedShift(id).technician_name&&request.resource.data.shift_id==id&&request.resource.data.job_type==assignedJobType(id)&&request.resource.data.unit_count==assignedUnitCount(id)
    &&request.resource.data.device_model==''&&request.resource.data.device_imeis is list&&request.resource.data.device_imeis.size()==0&&request.resource.data.sim_numbers is list&&request.resource.data.sim_numbers.size()==0&&request.resource.data.sim_count==0
    &&request.resource.data.customer_ref is string&&request.resource.data.customer_ref.size()>0&&request.resource.data.customer_ref.size()<=160&&request.resource.data.vehicle_ref is string&&request.resource.data.notes==''
    &&request.resource.data.completion_source=='admin_override'&&request.resource.data.completed_by_uid==request.auth.uid&&request.resource.data.completed_by_name is string&&request.resource.data.completed_by_name.size()>0&&request.resource.data.completed_by_name.size()<=160&&request.resource.data.completed_by_role==profile().role
    &&request.resource.data.completion_reason is string&&request.resource.data.completion_reason.size()>0&&request.resource.data.completion_reason.size()<=1000&&request.resource.data.timestamp==request.time&&request.resource.data.completed_at==request.time&&request.resource.data.captured_at==request.time
    &&!existsAfter(/databases/$(database)/documents/inventory_logs/$(id));
   allow create: if active()&&request.resource.data.keys().hasOnly(['technician_id','technician_name','shift_id','job_type','inspection_action','unit_count','unit_records','device_model','device_imeis','sim_numbers','sim_count','relay_12v_count','relay_24v_count','wire_count','sim_provider','customer_ref','vehicle_ref','notes','timestamp','completed_at','completion_latitude','completion_longitude','completion_accuracy_m','payment_received_amount','payment_method','captured_at'])
    &&request.resource.data.technician_id==request.auth.uid&&request.resource.data.shift_id==id&&assignedShift(id).technician_id==request.auth.uid&&request.resource.data.job_type==assignedJobType(id)&&request.resource.data.unit_count==assignedUnitCount(id)
    &&job(request.resource.data.job_type)&&request.resource.data.unit_count is int&&request.resource.data.unit_count>=1&&request.resource.data.unit_count<=50&&request.resource.data.device_imeis is list&&request.resource.data.sim_numbers is list
    &&request.resource.data.device_imeis.size()<51&&request.resource.data.sim_numbers.size()<51&&request.resource.data.sim_count==request.resource.data.sim_numbers.size()&&completionAccessories(request.resource.data)&&(!request.resource.data.keys().hasAny(['sim_provider'])||simProvider(request.resource.data.sim_provider))&&request.resource.data.timestamp==request.time&&request.resource.data.completed_at==request.time&&completionCoordinates(request.resource.data)&&(!request.resource.data.keys().hasAny(['payment_received_amount'])||request.resource.data.payment_received_amount is number&&request.resource.data.payment_received_amount>=0&&request.resource.data.payment_received_amount<=1000000)&&(!request.resource.data.keys().hasAny(['payment_method'])||request.resource.data.payment_method in ['cash','cheque'])&&request.resource.data.captured_at is timestamp
    &&request.resource.data.customer_ref is string&&request.resource.data.customer_ref.size()>0&&request.resource.data.customer_ref.size()<=160&&request.resource.data.vehicle_ref is string&&request.resource.data.notes is string&&request.resource.data.notes.size()<=1000
    &&((request.resource.data.job_type in ['new_installation','sim_device_change']&&model(request.resource.data.device_model)&&request.resource.data.device_imeis.size()==request.resource.data.unit_count&&request.resource.data.sim_numbers.size()==request.resource.data.unit_count&&getAfter(/databases/$(database)/documents/inventory_logs/$(id)).data.type=='installed')
     ||(request.resource.data.job_type=='sim_change'&&request.resource.data.device_model==''&&request.resource.data.device_imeis.size()==0&&request.resource.data.sim_numbers.size()==request.resource.data.unit_count&&getAfter(/databases/$(database)/documents/inventory_logs/$(id)).data.type=='sim-used')
     ||(request.resource.data.job_type=='payment_collection'&&request.resource.data.device_model==''&&request.resource.data.device_imeis.size()==0&&request.resource.data.sim_numbers.size()==0&&request.resource.data.sim_count==0&&request.resource.data.payment_received_amount is number&&request.resource.data.payment_method in ['cash','cheque']&&!existsAfter(/databases/$(database)/documents/inventory_logs/$(id)))
     ||(request.resource.data.job_type=='device_change'&&model(request.resource.data.device_model)&&request.resource.data.device_imeis.size()==request.resource.data.unit_count&&request.resource.data.sim_numbers.size()==0&&getAfter(/databases/$(database)/documents/inventory_logs/$(id)).data.type=='installed')
     ||(request.resource.data.job_type=='device_removal'&&request.resource.data.device_model==''&&request.resource.data.device_imeis.size()==request.resource.data.unit_count&&request.resource.data.sim_numbers.size()==0&&!existsAfter(/databases/$(database)/documents/inventory_logs/$(id)))
     ||(request.resource.data.job_type=='inspection'&&inspectionAction(request.resource.data.inspection_action)&&(
